# ==============================================
# Binance Trading Bot - 本地訓練環境配置
# ==============================================
# 複製此檔案為 .env.local 並填入你的配置
# 使用方式: export $(cat .env.local | xargs)

# ==================== 環境模式 ====================
ENVIRONMENT=development
DEBUG=true

# ==================== 訓練模式 ====================
# 本地訓練環境啟用訓練功能
TRAINING_ENABLED=true

# 模擬模式（本地訓練不執行真實交易）
DRY_RUN=true

# 禁用自動交易（本地只做訓練）
AUTO_START_TRADING=false

# ==================== 模型配置 ====================
# 訓練完成的模型輸出目錄
MODEL_OUTPUT_DIR=./models

# 啟動時自動載入模型
AUTO_LOAD_MODELS=true

# ==================== Railway 同步配置 ====================
# 你的線上部署 URL（填入自己的，勿提交真實值）
RAILWAY_API_URL=https://your-app.up.railway.app

# 你的部署 API Key（用於模型上傳；請使用高強度隨機字串，勿提交真實值）
RAILWAY_API_KEY=your_deploy_api_key_here

# ==================== 數據庫配置 ====================
# 方式一：使用本地 SQLite（推薦用於訓練）
USE_SQLITE=true
SQLITE_DB_PATH=./data/training.db

# 方式二：連接 Railway PostgreSQL（需要從 Railway 獲取連線字串）
# DATABASE_URL=postgresql://postgres:xxx@postgres.railway.internal:5432/railway

# ==================== Redis 配置（可選）====================
# 方式一：不使用 Redis（使用內存快取）
USE_MEMORY_CACHE=true

# 方式二：連接 Railway Redis（需要從 Railway 獲取連線字串）
# REDIS_URL=redis://default:xxx@redis.railway.internal:6379

# ==================== 幣安 API（可選，用於獲取訓練數據）====================
# 如果需要從幣安獲取即時數據進行訓練，填入 API 密鑰
# 否則可以使用本地歷史數據
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=false

# ==================== Telegram 通知（可選）====================
# 訓練完成後發送通知
TELEGRAM_ENABLED=false
# TELEGRAM_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==================== 日誌配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_PATH=./logs

# ==================== PyTorch 配置（可選）====================
# 強制使用 CPU（如果 MPS 有問題）
# PYTORCH_DEVICE=cpu

# 使用 MPS（Apple Silicon GPU）
# PYTORCH_DEVICE=mps
