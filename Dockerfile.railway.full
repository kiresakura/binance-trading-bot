# Railway 完整版 Dockerfile
# 包含 ML/AI 訓練功能，適用於 8GB RAM 環境
# v0.2.1 - Added Anthropic Claude API support

FROM python:3.12-slim

WORKDIR /app

# 安裝系統依賴（包含 ML 所需）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 複製依賴文件
COPY requirements-railway-full.txt .

# 安裝 Python 依賴
RUN pip install --no-cache-dir -r requirements-railway-full.txt \
    && rm -rf ~/.cache/pip

# 複製應用代碼
COPY src/ ./src/
COPY config/ ./config/
COPY .env* ./

# 創建必要目錄
RUN mkdir -p /app/logs /app/data /app/models

# Railway 使用 PORT 環境變數
ENV PORT=8000
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# 暴露端口
EXPOSE $PORT

# 運行應用（使用單 worker 避免重複訂單）
CMD uvicorn src.api.app:app --host 0.0.0.0 --port $PORT --workers 1
