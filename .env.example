# ==================== Binance API 配置 ====================
# 从 Binance 获取你的 API Key 后填写在这里

# API Key（必填）
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# 使用测试网（推荐先用测试网测试）
# true = 测试网（虚拟资金，安全，用于测试）
# false = 真实交易（需要真实资金，谨慎！）
BINANCE_TESTNET=true

# 如何获取 API Key：
#
# 【测试网】（推荐新手）：
# 1. 访问: https://testnet.binance.vision/
# 2. 用 GitHub 账号登录
# 3. 点击 "Generate HMAC_SHA256 Key"
# 4. 复制 API Key 和 Secret Key
#
# 【真实交易】（请谨慎）：
# 1. 登录 Binance: https://www.binance.com
# 2. 进入 账户 → API 管理
# 3. 创建新的 API Key
# 4. 权限设置：
#    ✅ 启用现货交易
#    ✅ 启用读取权限
#    ❌ 不要启用提币权限
# 5. 建议设置 IP 白名单

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=postgres
DB_PASSWORD=postgres123

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# ==================== RabbitMQ 配置 ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ==================== 风险管理参数 ====================
MAX_POSITION_SIZE=0.1
MAX_DAILY_LOSS=0.02
MAX_DRAWDOWN=0.10
MAX_CORRELATION=0.8

# ==================== Telegram 通知（可选）====================
TELEGRAM_TOKEN=your_telegram_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== 安全配置（重要！）====================
# JWT 簽章金鑰 - 必填，請用高強度隨機字串。未設定時 production 會拒絕啟動。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# API 金鑰（供 iOS App / 外部呼叫使用）格式：API_KEY_<名稱>=<金鑰>:<scope>
# scope 可為 read_only / trading / admin，例如：
# API_KEY_IOS_APP=replace_with_a_long_random_key:trading

# ==================== 应用配置 ====================
# 安全預設為 production；本地開發改為 development
ENVIRONMENT=production
DEBUG=false

# 模擬模式（安全預設 true=只記錄不下單）；要真實下單才設為 false
DRY_RUN=true
